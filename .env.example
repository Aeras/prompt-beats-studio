# PromptBeats local/runtime configuration template.
# Copy this file to .env for local development. Never commit real project values.

# Preferred external Supabase server configuration
EXTERNAL_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXTERNAL_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
EXTERNAL_SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Supported server fallbacks / tooling
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Browser/build configuration where required by tooling
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# PB-008 SEO/indexing configuration.
# Indexing is fail-closed unless BOTH values are explicitly valid/enabled.
# Preview/staging builds should leave VITE_PROMPTBEATS_INDEXING_ENABLED unset/false.
VITE_PROMPTBEATS_CANONICAL_ORIGIN=https://promptbeats.app
VITE_PROMPTBEATS_INDEXING_ENABLED=false

# AI Music Inspiration Beta: server-only, no VITE_ prefix. Leave unset until
# the operator verifies the search account's USD/credit ceiling and date.
TAVILY_API_KEY=
MUSIC_INSPIRATION_SEARCH_CREDIT_USD=
MUSIC_INSPIRATION_SEARCH_CREDIT_VERIFIED_AT=
